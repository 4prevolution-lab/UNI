{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uni.4prevolution.org/schemas/credential-collection/v0.1",
  "title": "UNI Open Badges Draft Collection",
  "type": "object",
  "required": ["schema", "status", "notice", "credentials"],
  "properties": {
    "schema": { "const": "https://uni.4prevolution.org/schemas/credential-collection/v0.1" },
    "status": { "const": "unsignedDraft" },
    "notice": { "type": "string", "minLength": 1 },
    "credentials": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["@context", "id", "type", "issuer", "validFrom", "credentialSubject", "evidence", "credentialStatus"],
        "properties": {
          "type": { "type": "array", "contains": { "const": "OpenBadgeCredential" } },
          "credentialStatus": {
            "type": "object",
            "required": ["status", "notice"],
            "properties": { "status": { "const": "unsignedDraft" } }
          }
        }
      }
    }
  }
}
